# Board: dongle-s3-0.96 (ESP32-S3 + W25Q128 16MB flash, native USB on GPIO19/20)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# BLE HID host (ESP32-S3 has BLE only, no BT Classic)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# BLE 4.2 only: with 5.0 also on, Bluedroid switches to extended connect (HCI 0x2043) after any 5.0 event (e.g. a PHY
# update from the remote), and the controller rejects it (Cmd Disallowed) because we scan with legacy commands ->
# no reconnect until reboot.
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16

# FAT on flash for the USB drive (WL sector 4096 -> MSC buffer must be >= 4096)
CONFIG_WL_SECTOR_SIZE_4096=y
CONFIG_FATFS_LFN_HEAP=y

# USB composite (descriptors in main/usb.c)
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_TINYUSB_HID_COUNT=1

# Logs go to UART0 (header pins GPIO43 TX / GPIO44 RX). USB-Serial/JTAG is gone once TinyUSB owns the PHY.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Crash dump kept in flash -> `dev.ps1 coredump`
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Reconnect loop retries every ~10s instead of blocking scans for 30s (main.c ble_task)
CONFIG_BT_BLE_ESTAB_LINK_CONN_TOUT=10
